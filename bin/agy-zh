#!/usr/bin/env bash
set -euo pipefail

# Antigravity 中文双入口编排器 (macOS)
# 负责在“中文入口”启动期间启用中文思考提示词插件，并在退出后自动复原，
# 从而与原版 Antigravity 入口完全隔离。

PLUGIN_NAME="antigravity-zh-prompt"
CONFIG_DIR="${GEMINI_CONFIG_DIR:-$HOME/.gemini/config}"
CONFIG_FILE="$CONFIG_DIR/config.json"
PLUGIN_DIR="$CONFIG_DIR/plugins/$PLUGIN_NAME"
LOG_DIR="$HOME/Library/Logs"
LOG_FILE="$LOG_DIR/antigravity-hans.log"
OVERLAY_VERSION="agy-zh-v4"

resolve_self_path() {
  local src="${BASH_SOURCE[0]}"
  local dir
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

find_hans_bin() {
  if [[ -n "${AGY_HANS_BIN:-}" && -x "${AGY_HANS_BIN:-}" ]]; then
    printf '%s\n' "$AGY_HANS_BIN"
    return 0
  fi
  if [[ -x "$HOME/.local/bin/antigravity-hans" ]]; then
    printf '%s\n' "$HOME/.local/bin/antigravity-hans"
    return 0
  fi
  if command -v antigravity-hans >/dev/null 2>&1; then
    command -v antigravity-hans
    return 0
  fi
  return 1
}

find_original_app() {
  local candidates=()
  if [[ -n "${AGY_ZH_APPS_DIR:-}" ]]; then
    candidates+=("$AGY_ZH_APPS_DIR/Antigravity.app")
  fi
  candidates+=(
    "/Applications/Antigravity.app"
    "$HOME/Applications/Antigravity.app"
  )
  local app
  for app in "${candidates[@]}"; do
    if [[ -d "$app" ]]; then
      printf '%s\n' "$app"
      return 0
    fi
  done
  return 1
}

find_shortcut_app() {
  if [[ -n "${AGY_ZH_APPS_DIR:-}" ]]; then
    if [[ -d "$AGY_ZH_APPS_DIR/Antigravity 中文.app" ]]; then
      printf '%s\n' "$AGY_ZH_APPS_DIR/Antigravity 中文.app"
      return 0
    fi
    return 1
  fi
  local candidates=(
    "/Applications/Antigravity 中文.app"
    "$HOME/Applications/Antigravity 中文.app"
  )
  local app
  for app in "${candidates[@]}"; do
    if [[ -d "$app" ]]; then
      printf '%s\n' "$app"
      return 0
    fi
  done
  return 1
}

set_plugin_enabled() {
  local enabled_str="$1"
  python3 - "$CONFIG_FILE" "$PLUGIN_NAME" "$enabled_str" <<'PY'
import json
import os
import sys
import tempfile

config_file, plugin_name, enabled_str = sys.argv[1], sys.argv[2], sys.argv[3]
enabled = enabled_str.lower() == "true"
config_dir = os.path.dirname(config_file)
os.makedirs(config_dir, exist_ok=True)

data = {}
file_mode = 0o600
if os.path.exists(config_file):
    try:
        file_mode = os.stat(config_file).st_mode & 0o777
        with open(config_file, "r", encoding="utf-8") as f:
            loaded = json.load(f)
            if isinstance(loaded, dict):
                data = loaded
    except Exception as exc:
        sys.stderr.write(f"[错误] 读取配置文件失败 ({config_file}): {exc}\n")
        sys.exit(1)

plugins = data.get("plugins")
if not isinstance(plugins, dict):
    plugins = {}
data["plugins"] = plugins

entry = plugins.get(plugin_name)
if not isinstance(entry, dict):
    entry = {}
entry["enabled"] = enabled
plugins[plugin_name] = entry

fd, tmp_path = tempfile.mkstemp(prefix=".config.", suffix=".tmp", dir=config_dir)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.chmod(tmp_path, file_mode)
    os.replace(tmp_path, config_file)
except Exception:
    if os.path.exists(tmp_path):
        os.unlink(tmp_path)
    raise
PY
}

is_plugin_enabled() {
  python3 - "$CONFIG_FILE" "$PLUGIN_DIR/plugin.json" "$PLUGIN_NAME" <<'PY'
import json
import os
import sys

config_file, plugin_json, plugin_name = sys.argv[1], sys.argv[2], sys.argv[3]

if os.path.exists(config_file):
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        plugins = data.get("plugins", {})
        if isinstance(plugins, dict) and isinstance(plugins.get(plugin_name), dict):
            val = plugins[plugin_name].get("enabled")
            if isinstance(val, bool):
                print("true" if val else "false")
                sys.exit(0)
    except Exception:
        pass

if os.path.exists(plugin_json):
    try:
        with open(plugin_json, "r", encoding="utf-8") as f:
            pdata = json.load(f)
        if pdata.get("disabled") is True:
            print("false")
            sys.exit(0)
        print("true")
        sys.exit(0)
    except Exception:
        pass

print("false")
PY
}

list_active_hans_pids() {
  ps -axo pid=,args= 2>/dev/null | awk '
    $0 !~ /^[[:space:]]*[0-9]+[[:space:]]+awk/ {
      cmd = $2
      if (cmd ~ /(^|\/)antigravity-hans$/ && $0 ~ /(^|[[:space:]])--app([[:space:]]|$)/) {
        print $1
      }
    }
  '
}

has_active_hans_monitor() {
  [[ -n "$(list_active_hans_pids)" ]]
}

ensure_enhanced_overlay() {
  local hans_bin="$1"
  local force="${2:-false}"
  local overlay_path
  overlay_path="$(dirname "$hans_bin")/antigravity-hans-overlay.js"

  python3 - "$hans_bin" "$overlay_path" "$OVERLAY_VERSION" "$force" <<'PY'
import hashlib
import os
import sys
import tempfile

hans_bin, overlay_path, overlay_ver, force_flag = sys.argv[1:5]
force = force_flag == "true"

with open(hans_bin, "rb") as f:
    raw = f.read()

bin_sha256 = hashlib.sha256(raw).hexdigest()[:16]
header_comment = f"// antigravity-zh-launcher overlay: {overlay_ver}; engine_sha256={bin_sha256}"

if not force and os.path.isfile(overlay_path):
    try:
        with open(overlay_path, "r", encoding="utf-8") as ef:
            first_line = ef.readline().rstrip("\r\n")
        if first_line == header_comment:
            sys.exit(0)
    except Exception:
        pass

start_marker = (
    b"(() => {\n"
    b"  if (typeof window === 'undefined') return;\n"
    b"  const fingerprint = window.__antigravityZhPatchRequestedFingerprint"
)
start_idx = raw.find(start_marker)
if start_idx == -1:
    sys.stderr.write(f"[错误] 未能在 {hans_bin} 中定位内嵌汉化脚本起点。\n")
    sys.exit(1)

end_marker = b"})();"
end_idx = raw.find(end_marker, start_idx + len(start_marker))
if end_idx == -1:
    sys.stderr.write(f"[错误] 未能在 {hans_bin} 中定位内嵌汉化脚本终点。\n")
    sys.exit(1)

js = raw[start_idx : end_idx + len(end_marker)].decode("utf-8")


def replace_once(text, target, replacement, label):
    count = text.count(target)
    if count != 1:
        sys.stderr.write(f"[错误] 增强补丁锚点匹配异常 ({label}): count={count}\n")
        sys.exit(1)
    return text.replace(target, replacement, 1)


