    ["Wrote", "已写入"],
    ["Listing", "正在列出"],
    ["Listed", "已列出"],
    ["Checking", "正在检查"],
    ["Checked", "已检查"],
    ["Viewing", "正在查看"],
    ["Viewed", "已查看"],
